{
  "expo": {
    "name": "Meeting Pro",
    "slug": "whatsapp-transcriber",
    "scheme": "meetingpro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "assets/**"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lumiqindustries.meetingpro",
      "deploymentTarget": "16.4",
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a1628"
      },
      "package": "com.lumiqindustries.meetingpro",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro",
      "name": "VILATECH Meeting Pro",
      "shortName": "Meeting Pro",
      "description": "VILATECH Meeting Pro — WhatsApp Business call minutes and transcripts",
      "themeColor": "#0a1628",
      "backgroundColor": "#0a1628"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a1628",
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-audio",
      "expo-status-bar",
      "expo-font",
      "@clerk/expo"
    ],
    "extra": {
      "eas": {
        "projectId": "placeholder-update-before-build"
      }
    },
    "owner": "vilatechorg"
  }
}
