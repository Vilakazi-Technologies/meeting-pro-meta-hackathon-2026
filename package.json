{
  "name": "whatsapp-transcriber",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "preflight": "node scripts/preflight.mjs",
    "verify:meta": "node scripts/verify-meta-setup.mjs",
    "web:clear": "expo start --web --clear",
    "supabase:login": "npx supabase@latest login",
    "supabase:secrets": "npx supabase@latest secrets set --env-file supabase/.env.secrets --project-ref mjxfpovawoztumfcblhm",
    "supabase:deploy:summarize": "npx supabase@latest functions deploy summarize-transcript --project-ref mjxfpovawoztumfcblhm",
    "supabase:db:push": "npx supabase@latest db push --project-ref mjxfpovawoztumfcblhm"
  },
  "dependencies": {
    "@clerk/expo": "^4.14.2",
    "@clerk/localizations": "^4.24.2",
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@supabase/supabase-js": "^2.109.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "expo": "^58.0.0",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-auth-session": "~58.0.14",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.13",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.23.0",
    "@types/node": "^26.6.5",
    "typescript": "~6.0.3"
  }
}
