# Copy to supabase/.env.secrets (gitignored). Apply with:
#   npm run supabase:secrets
# Local serve: copy service role to supabase/.env.local (see README) — never push service role as a function secret.
#
# Never commit real values.

META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=

# AI meeting minutes — prefer Meta Model API (hackathon / production):
MODEL_API_KEY=
# Optional override (default muse-spark-1.3):
# META_SUMMARY_MODEL=muse-spark-1.3
#
# Legacy fallback only when MODEL_API_KEY is unset:
# ANTHROPIC_API_KEY=
