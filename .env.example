# Copy to .env — never commit real values.

# Clerk (identity) — publishable key only; never put CLERK_SECRET_KEY in this file.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Vercel / Next-style name also works at build time if you set it in the dashboard:
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Supabase (data + RLS via Clerk JWT template "supabase")
# Project ref: mjxfpovawoztumfcblhm → https://mjxfpovawoztumfcblhm.supabase.co
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# supabase = live DB (requires sign-in) | mock = demo transcripts only (no Supabase keys needed)
EXPO_PUBLIC_DATA_SOURCE=mock

# Meta AI hackathon (optional — not used in DB; for your reference)
# EXPO_PUBLIC_META_AI_PROJECT_ID=
# EXPO_PUBLIC_META_AI_TEAM_ID=
# Meta Business Suite business/portfolio ID (not the same as WhatsApp WABA ID)
# EXPO_PUBLIC_META_BUSINESS_SUITE_ID=

# WhatsApp — developers.facebook.com → WhatsApp → API Setup (prefill Connect form)
# EXPO_PUBLIC_META_WABA_ID=
# EXPO_PUBLIC_META_PHONE_NUMBER_ID=
# EXPO_PUBLIC_META_DISPLAY_PHONE=
